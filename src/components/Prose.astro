---
/**
 * Long-form text wrapper for legal and policy pages.
 *
 * Tailwind's typography plugin is not installed — one wrapper with descendant
 * selectors covers the handful of prose pages on this site and avoids adding a
 * dependency for it.
 *
 * Capped at a readable measure by the `narrow` Container the pages use.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class={`
    text-ink-700
    [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:text-2xl [&_h2]:text-ink-950
    [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-lg [&_h3]:text-ink-950
    [&_p]:mt-4 [&_p]:leading-relaxed
    [&_ul]:mt-4 [&_ul]:space-y-2.5 [&_ul]:pl-5
    [&_li]:list-disc [&_li]:leading-relaxed [&_li]:marker:text-ink-400
    [&_a]:font-medium [&_a]:text-accent-600 [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-accent-700
    [&_strong]:font-semibold [&_strong]:text-ink-900
    [&_h2:first-child]:mt-0
    ${className}
  `}
>
  <slot />
</div>
