---
import Icon from './Icon.astro';
import Reveal from './Reveal.astro';
import { stats } from '../data/site';

/**
 * Bento grid — layout adapted from "Feature Bento" by @uilayout.contact
 * on 21st.dev (https://21st.dev/@uilayout.contact/components/feature-bento).
 *
 * Retrieved via the 21st.dev MCP and rewritten as a static Astro component:
 * the original is a React client component built on lucide-react. The grid
 * structure (2×2 hero card + five tiles on a 3-column, fixed-row-height
 * grid) is kept; the stock-photo background, purple gradients and travel
 * copy are replaced per the project's anti-pattern list.
 */

const podStat = stats[0];
const cycleStat = stats[2];
const greenStat = stats[3];
---

<div class="grid auto-rows-[minmax(220px,auto)] grid-cols-1 gap-4 md:grid-cols-3">
  <!-- Hero card, 2×2 -->
  <Reveal
    class="group relative overflow-hidden rounded-panel bg-ink-950 p-8 md:col-span-2 md:row-span-2 sm:p-10"
    index={0}
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background-image:linear-gradient(to right,#1e293b 1px,transparent 1px),linear-gradient(to bottom,#1e293b 1px,transparent 1px);background-size:48px 48px;mask-image:radial-gradient(ellipse 70% 70% at 80% 10%,#000,transparent 70%);-webkit-mask-image:radial-gradient(ellipse 70% 70% at 80% 10%,#000,transparent 70%)"
    >
    </div>

    <div class="relative flex h-full flex-col justify-between gap-10">
      <div
        class="inline-flex w-fit items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm"
      >
        <span class="size-2 rounded-full bg-energy-500"></span>
        End to end
      </div>

      <div>
        <h3 class="text-3xl leading-tight text-white sm:text-4xl">
          One partner, from concept<br class="hidden sm:inline" /> to commissioning.
        </h3>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-ink-400">
          Design, supply, installation, integration and long-term operations
          for solar, wind and hybrid plants — handled by one team, under one
          scope of work.
        </p>

        <ul class="mt-7 grid gap-2.5 sm:grid-cols-2">
          {
            [
              'System sizing and feasibility',
              'EPC and site integration',
              'Grid compliance support',
              'Operations and maintenance',
            ].map((item) => (
              <li class="flex items-center gap-2.5 text-[0.9375rem] text-ink-300">
                <Icon name="check" class="size-4 shrink-0 text-energy-500" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Reveal>

  <!-- Energy per container -->
  <Reveal
    class="relative flex flex-col justify-between overflow-hidden rounded-panel bg-accent-600 p-8 text-white"
    index={1}
  >
    <div
      aria-hidden="true"
      class="absolute -top-10 -right-10 size-40 rounded-full bg-white/10 blur-3xl"
    >
    </div>
    <div
      class="relative flex size-12 items-center justify-center rounded-lg bg-white/15"
    >
      <Icon name="container" class="size-6" />
    </div>
    <div class="relative mt-6">
      <p class="text-5xl font-extrabold tracking-tight">
        {podStat.value}<span class="ml-1 text-2xl font-bold">{podStat.unit}</span>
      </p>
      <p class="mt-1.5 text-sm font-medium text-accent-100">
        {podStat.label}
      </p>
    </div>
  </Reveal>

  <!-- AI BMS feature -->
  <Reveal
    class="flex flex-col justify-between rounded-panel border border-ink-200 bg-white p-8 shadow-soft-sm transition-shadow duration-200 hover:shadow-soft-md"
    index={2}
  >
    <div
      class="flex size-12 items-center justify-center rounded-lg bg-ink-950 text-white"
    >
      <Icon name="cpu" class="size-6" />
    </div>
    <div class="mt-6">
      <h3 class="text-xl text-ink-950">AI-enabled BMS</h3>
      <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-600">
        Cell-level monitoring with predictive balancing and early fault
        detection, so degradation is caught long before it becomes downtime.
      </p>
    </div>
  </Reveal>

  <!-- Cycle life -->
  <Reveal
    class="relative flex flex-col justify-center overflow-hidden rounded-panel border border-ink-200 bg-white p-8 shadow-soft-sm"
    index={3}
  >
    <div
      class="flex size-12 items-center justify-center rounded-lg bg-energy-50 text-energy-700"
    >
      <Icon name="gauge" class="size-6" />
    </div>
    <p class="mt-6 text-5xl font-extrabold tracking-tight text-ink-950">
      {cycleStat.value}
    </p>
    <p class="mt-1.5 text-sm font-medium text-ink-600">
      {cycleStat.label}
    </p>
  </Reveal>

  <!-- CTA tile -->
  <Reveal class="rounded-panel bg-ink-900 p-0" index={4}>
    <a
      href="/contact/"
      class="group flex h-full cursor-pointer flex-col justify-between rounded-panel p-8 text-white transition-colors duration-200 hover:bg-ink-800"
    >
      <div class="flex items-start justify-between">
        <span
          class="rounded-full bg-white/15 px-3 py-1.5 text-xs font-bold tracking-wider uppercase"
        >
          Enquire
        </span>
        <span
          class="flex size-10 items-center justify-center rounded-full bg-white/15 transition-transform duration-200 group-hover:rotate-45"
        >
          <Icon name="arrowUpRight" class="size-4" />
        </span>
      </div>
      <h3 class="mt-8 text-2xl leading-tight text-white">
        Request a<br />specification pack
      </h3>
    </a>
  </Reveal>

  <!-- Fills the third cell of the last row; without it the grid ends ragged. -->
  <Reveal
    class="relative flex flex-col justify-center overflow-hidden rounded-panel border border-energy-500/30 bg-energy-50 p-8"
    index={5}
  >
    <div
      class="flex size-12 items-center justify-center rounded-lg bg-energy-600 text-white"
    >
      <Icon name="leaf" class="size-6" />
    </div>
    <p class="mt-6 text-5xl font-extrabold tracking-tight text-ink-950">
      {greenStat.value}<span class="text-3xl">{greenStat.unit}</span>
    </p>
    <p class="mt-1.5 text-sm font-medium text-energy-700">
      {greenStat.label}
    </p>
  </Reveal>
</div>
