---
/**
 * Eyebrow + heading + lead paragraph, the standard opener for a section.
 *
 * Always renders an <h2>. Every page has exactly one <h1> (in PageHeader or
 * Hero), so section openers must sit a level below it — using this component
 * everywhere is what keeps the heading outline valid without anyone having to
 * think about it.
 *
 * Capped at max-w-2xl regardless of the container width: a lead paragraph
 * running the full width of a 1440px screen is far past the ~75-character
 * measure that stays comfortable to read.
 */
import Reveal from './Reveal.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  /** `dark` for navy sections — lightens the eyebrow and body for contrast. */
  tone?: 'light' | 'dark';
  class?: string;
}

const {
  eyebrow,
  title,
  lead,
  align = 'left',
  tone = 'light',
  class: className = '',
} = Astro.props;

const isDark = tone === 'dark';
---

<Reveal
  class={`${align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'} ${className}`}
>
  {/* The eyebrow is a <p>, not a heading — it labels the section visually but
      putting it in the heading outline would create a phantom level. */}
  {
    eyebrow && (
      <p
        class={`mb-3 text-xs font-bold tracking-[0.14em] uppercase ${
          isDark ? 'text-accent-300' : 'text-accent-600'
        }`}
      >
        {eyebrow}
      </p>
    )
  }
  <h2
    class={`text-3xl leading-[1.15] sm:text-4xl lg:text-[2.75rem] ${
      isDark ? 'text-white' : 'text-ink-950'
    }`}
  >
    {title}
  </h2>
  {
    lead && (
      <p
        class={`mt-4 text-lg leading-relaxed ${isDark ? 'text-ink-300' : 'text-ink-600'}`}
      >
        {lead}
      </p>
    )
  }
</Reveal>
