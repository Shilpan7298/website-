---
/**
 * Urjapod Energy logo, rebuilt as vector from the supplied artwork.
 *
 * Drawn rather than embedded as a PNG so it stays sharp on every display,
 * costs ~1 KB inline instead of a separate image request, and recolours from
 * the palette tokens rather than being baked to fixed hexes.
 *
 * Two variants:
 *   full — the complete lockup: battery, white "U", amber bolt, wordmark
 *   mark — battery + U + bolt only, for tight spaces and the favicon
 *
 * The wordmark is SVG <text> in the site font. That keeps one element and one
 * set of proportions; if you later receive the original vector artwork from
 * your designer, replace the paths here and everything else follows.
 *
 * Always decorative (aria-hidden) — the surrounding link carries the label,
 * so assistive tech announces "Urjapod Energy, home" once, not twice.
 */
interface Props {
  variant?: 'full' | 'mark';
  /** `onDark` swaps the battery body to white-on-transparent for navy areas. */
  tone?: 'default' | 'onDark';
  class?: string;
}

const { variant = 'full', tone = 'default', class: className = '' } =
  Astro.props;

const isDark = tone === 'onDark';
// On navy the solid blue battery would disappear, so it becomes an outline.
const bodyFill = isDark ? 'none' : 'var(--color-brand-600)';
const bodyStroke = isDark ? 'rgba(255,255,255,0.45)' : 'none';
const uFill = isDark ? '#ffffff' : '#ffffff';
const textFill = '#ffffff';
---

{
  variant === 'mark' ? (
    <svg
      viewBox="0 0 232 260"
      class={className}
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <rect
        x="8"
        y="24"
        width="188"
        height="212"
        rx="46"
        fill={bodyFill}
        stroke={bodyStroke}
        stroke-width="8"
      />
      <rect x="204" y="94" width="26" height="72" rx="13" fill={isDark ? 'rgba(255,255,255,0.45)' : 'var(--color-brand-600)'} />
      {/* The "U" — thick arms, rounded bowl */}
      <path
        d="M52 62 V148 A52 52 0 0 0 156 148 V62 H122 V148 A18 18 0 0 1 86 148 V62 Z"
        fill={uFill}
        fill-rule="evenodd"
      />
      {/* Lightning bolt, overlapping the U's right arm */}
      <path
        d="M148 54 L106 128 H132 L120 194 L170 118 H142 Z"
        fill="var(--color-volt-500)"
      />
    </svg>
  ) : (
    <svg
      viewBox="0 0 620 260"
      class={className}
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <rect
        x="8"
        y="24"
        width="568"
        height="212"
        rx="46"
        fill={bodyFill}
        stroke={bodyStroke}
        stroke-width="8"
      />
      <rect
        x="584"
        y="94"
        width="26"
        height="72"
        rx="13"
        fill={isDark ? 'rgba(255,255,255,0.45)' : 'var(--color-brand-600)'}
      />
      <path
        d="M52 62 V148 A52 52 0 0 0 156 148 V62 H122 V148 A18 18 0 0 1 86 148 V62 Z"
        fill={uFill}
        fill-rule="evenodd"
      />
      <path
        d="M148 54 L106 128 H132 L120 194 L170 118 H142 Z"
        fill="var(--color-volt-500)"
      />
      <text
        x="216"
        y="126"
        fill={textFill}
        font-family="var(--font-sans)"
        font-size="76"
        font-weight="800"
        font-style="italic"
        letter-spacing="-2"
      >
        Urjapod
      </text>
      <text
        x="216"
        y="208"
        fill={textFill}
        font-family="var(--font-sans)"
        font-size="76"
        font-weight="800"
        font-style="italic"
        letter-spacing="-2"
      >
        Energy
      </text>
    </svg>
  )
}
