---
/**
 * Brand mark + wordmark.
 *
 * The mark is inline SVG using the palette's CSS variables, so it recolours
 * automatically if a token changes and needs no separate image request.
 *
 * NOTE: this is a placeholder identity, not an official Urjapod logo — the
 * real site's mark could not be retrieved (urjapod.com returns 403 to
 * automated clients). Replace the <svg> here and public/favicon.svg together;
 * they are intentionally the same geometry.
 */
interface Props {
  class?: string;
  /** `onDark` inverts the wordmark for navy backgrounds. */
  tone?: 'default' | 'onDark';
  showWordmark?: boolean;
}

const { class: className = '', tone = 'default', showWordmark = true } =
  Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  {/* Mark: a container pod, energised. Reads cleanly down to 24px. */}
  <svg
    viewBox="0 0 32 32"
    width="32"
    height="32"
    fill="none"
    class="size-8 shrink-0"
    aria-hidden="true"
  >
    <rect width="32" height="32" rx="9" fill="var(--color-ink-900)"></rect>
    <rect
      x="5.5"
      y="9.5"
      width="21"
      height="13"
      rx="3.5"
      stroke="var(--color-accent-400)"
      stroke-width="1.6"
      opacity="0.55"></rect>
    <path
      d="M17.6 10.4 12.2 17.1h3.1l-1.1 4.9 5.5-6.8h-3.2z"
      fill="var(--color-accent-400)"></path>
  </svg>
  {
    showWordmark && (
      <span
        class={`text-[1.0625rem] font-extrabold tracking-tight ${
          tone === 'onDark' ? 'text-white' : 'text-ink-950'
        }`}
      >
        Urjapod
      </span>
    )
  }
</span>
