---
/**
 * Sticky site header.
 *
 * Nav mirrors the live site: Home (the logo) · Sodium Ion · Product · Blog ·
 * Contact, plus the Bill Analyser as the one primary action.
 *
 * The Bill Analyser is an OUTBOUND link (see `billAnalyser` in
 * src/data/site.ts) so it carries an external-link icon, target="_blank" and
 * rel="noopener noreferrer". Set `external: false` there and it renders as an
 * ordinary internal link instead — no markup change needed here.
 */
import Container from './Container.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, billAnalyser, company } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const outbound = billAnalyser.external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<header
  class="sticky top-0 z-50 border-b border-ink-200/70 bg-white/85 backdrop-blur-md supports-[backdrop-filter]:bg-white/70"
>
  <Container width="wide">
    <div class="flex h-16 items-center justify-between gap-4 lg:h-20">
      <a
        href="/"
        class="shrink-0 rounded-lg transition-opacity hover:opacity-85"
        aria-label={`${company.name} — home`}
      >
        <Logo class="h-9 w-auto lg:h-10" />
      </a>

      <nav aria-label="Primary" class="hidden items-center gap-1 lg:flex">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'relative rounded-lg px-3.5 py-2 text-[0.9375rem] font-semibold transition-colors duration-200',
                isActive(item.href)
                  ? 'text-brand-700'
                  : 'text-ink-600 hover:text-brand-700',
              ]}
            >
              {item.label}
              {/* Active page gets a volt underline — the bolt colour used as a
                  graphic, never as text, so contrast is unaffected. */}
              {isActive(item.href) && (
                <span
                  aria-hidden="true"
                  class="absolute inset-x-3.5 -bottom-0.5 h-[3px] rounded-full bg-volt-500"
                />
              )}
            </a>
          ))
        }
      </nav>

      <div class="hidden lg:block">
        <a
          href={billAnalyser.href}
          {...outbound}
          class="group inline-flex h-11 cursor-pointer items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 text-[0.9375rem] font-semibold text-white shadow-brand-sm transition-all duration-200 hover:bg-brand-700 hover:shadow-brand-md"
        >
          {billAnalyser.label}
          <Icon
            name={billAnalyser.external ? 'arrowUpRight' : 'arrowRight'}
            class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
          />
          {billAnalyser.external && (
            <span class="sr-only">(opens in a new tab)</span>
          )}
        </a>
      </div>

      <button
        type="button"
        id="nav-toggle"
        class="inline-flex size-11 cursor-pointer items-center justify-center rounded-lg text-ink-800 transition-colors hover:bg-ink-100 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" class="size-6" id="nav-icon-open" />
        <Icon name="x" class="hidden size-6" id="nav-icon-close" />
      </button>
    </div>
  </Container>

  {/* Mobile panel. Rendered in the HTML and toggled with `hidden`, so it needs
      no framework and appears instantly on first tap. */}
  <div id="mobile-nav" class="hidden border-t border-ink-200 bg-white lg:hidden">
    <Container width="wide">
      <nav aria-label="Mobile" class="flex flex-col gap-1 py-4">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-lg px-3 py-3 text-base font-semibold transition-colors',
                isActive(item.href)
                  ? 'bg-brand-50 text-brand-700'
                  : 'text-ink-700 hover:bg-ink-100 hover:text-brand-700',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={billAnalyser.href}
          {...outbound}
          class="mt-3 inline-flex h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 font-semibold text-white"
        >
          {billAnalyser.label}
          <Icon
            name={billAnalyser.external ? 'arrowUpRight' : 'arrowRight'}
            class="size-4"
          />
        </a>
      </nav>
    </Container>
  </div>
</header>

<script>
  // Mobile nav. Deliberately vanilla: this runs on every page, and a React
  // island would cost ~45 KB of runtime to toggle one class.
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  if (toggle && panel && iconOpen && iconClose) {
    const setOpen = (open: boolean) => {
      panel.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    toggle.addEventListener('click', () =>
      setOpen(panel.classList.contains('hidden'))
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Reset when the viewport grows past the breakpoint mid-session.
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
