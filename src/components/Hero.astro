---
/**
 * Home page hero. Home-page-only, so it lives here rather than in PageHeader
 * (which every other page uses).
 *
 * Contains the page's single <h1>. Everything above the fold is static HTML
 * with no image request, so the largest contentful paint is text in a
 * preloaded font — the fastest LCP available short of an empty page.
 *
 * Deliberately NOT wrapped in <Reveal>: the hero is visible immediately, and
 * fading in the headline would delay the content people came for.
 */
import Container from './Container.astro';
import Button from './Button.astro';
import PodVisual from './PodVisual.astro';
import Icon from './Icon.astro';
import { company } from '../data/site';

// Scannable proof points beside the product visual. Kept to four: this is a
// glance, not the spec table (that lives on /products/).
const chips = [
  { icon: 'container', label: '20 ft ISO container' },
  { icon: 'battery', label: 'Prismatic LFP cells' },
  { icon: 'cpu', label: 'AI-enabled BMS' },
  { icon: 'shield', label: 'Multi-layer fire safety' },
] as const;
---

<section class="relative overflow-hidden bg-ink-50">
  {/* Engineering-drawing grid. Two CSS gradients rather than an image, and a
       radial mask fades it out at the edges so it never competes with the
       headline. `aria-hidden` + `pointer-events-none` keep it purely
       decorative: invisible to screen readers, unclickable by mice.
       The mask is inline because the percentages are one-off; nothing else on
       the site reuses this exact geometry. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.55]"
    style="background-image:linear-gradient(to right,var(--color-ink-200) 1px,transparent 1px),linear-gradient(to bottom,var(--color-ink-200) 1px,transparent 1px);background-size:64px 64px;mask-image:radial-gradient(ellipse 80% 60% at 50% 0%,#000 30%,transparent 78%);-webkit-mask-image:radial-gradient(ellipse 80% 60% at 50% 0%,#000 30%,transparent 78%)"
  >
  </div>

  <Container width="wide" class="relative">
    <div
      class="grid items-center gap-14 py-16 sm:py-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:py-28"
    >
      <div>
        <a
          href="/technology/"
          class="group inline-flex items-center gap-2.5 rounded-full border border-ink-200 bg-white/80 py-1.5 pr-4 pl-2 text-sm font-medium text-ink-700 shadow-soft-sm backdrop-blur-sm transition-colors hover:border-ink-300 hover:text-ink-950"
        >
          <span class="relative flex size-2 shrink-0">
            <span
              class="absolute inline-flex size-full animate-ping rounded-full bg-energy-500 opacity-75"
            ></span>
            <span
              class="relative inline-flex size-2 rounded-full bg-energy-600"
            ></span>
          </span>
          Building India's first prismatic sodium-ion prototype
          <Icon
            name="arrowRight"
            class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </a>

        <h1
          class="mt-7 text-[2.5rem] leading-[1.08] sm:text-5xl lg:text-[3.5rem]"
        >
          Grid-scale energy storage, engineered in India.
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600">
          Urjapod builds containerised battery systems that let solar and wind
          plants deliver power when the grid actually needs it — from concept
          and design through commissioning, operations and maintenance.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <Button href="/products/" size="lg" icon="right">
            Explore Pod Gen 1
          </Button>
          <Button href="/contact/" size="lg" variant="secondary">
            Talk to our team
          </Button>
        </div>

        <dl class="mt-11 flex flex-wrap gap-x-8 gap-y-4 border-t border-ink-200 pt-7">
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink-600 uppercase">
              Registered
            </dt>
            <dd class="mt-1 text-sm font-semibold text-ink-900">
              {company.incorporated}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink-600 uppercase">
              Based in
            </dt>
            <dd class="mt-1 text-sm font-semibold text-ink-900">
              {company.address.city}, {company.address.state}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink-600 uppercase">
              CIN
            </dt>
            <dd class="mt-1 font-mono text-sm font-semibold text-ink-900">
              {company.cin}
            </dd>
          </div>
        </dl>
      </div>

      <div class="relative">
        <div
          class="rounded-hero border border-ink-200 bg-white p-6 shadow-soft-xl sm:p-8"
        >
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-bold tracking-[0.14em] text-accent-600 uppercase">
                Flagship system
              </p>
              <p class="mt-1 text-xl font-bold text-ink-950">Pod Gen 1</p>
            </div>
            <span
              class="rounded-full bg-energy-50 px-3 py-1 text-xs font-semibold text-energy-700"
            >
              In production
            </span>
          </div>

          <PodVisual class="mt-4" />

          <ul class="mt-2 grid grid-cols-2 gap-2.5">
            {
              chips.map((chip) => (
                <li class="flex items-center gap-2 rounded-lg bg-ink-100 px-3 py-2.5 text-[0.8125rem] font-medium text-ink-700">
                  <Icon name={chip.icon} class="size-4 shrink-0 text-accent-600" />
                  {chip.label}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>
