---
/**
 * Home page hero. Home-only, so it lives here rather than in PageHeader.
 *
 * Carries the page's single <h1>. Everything above the fold is static HTML
 * with no image request, so the largest contentful paint is text in a
 * preloaded font — the fastest LCP available short of a blank page.
 *
 * Deliberately NOT wrapped in <Reveal>: the hero is visible immediately, and
 * fading in the headline would delay the content people came for.
 *
 * The headline and lead are Urjapod's own positioning from the live site.
 * Do not replace them with invented marketing copy.
 */
import Container from './Container.astro';
import Button from './Button.astro';
import PodVisual from './PodVisual.astro';
import Icon from './Icon.astro';
import { company } from '../data/site';

const chips = [
  { icon: 'container', label: '20 ft container' },
  { icon: 'battery', label: 'Prismatic LFP' },
  { icon: 'cpu', label: 'AI-enabled BMS' },
  { icon: 'shield', label: 'Inbuilt safety' },
] as const;
---

<section class="relative overflow-hidden bg-brand-950">
  {/* Depth: a soft brand glow top-right, plus an engineering grid. Both are
      CSS gradients — no image request, nothing to shift layout. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background:radial-gradient(60rem 40rem at 85% -10%, rgba(43,76,155,0.55), transparent 65%), radial-gradient(40rem 30rem at 5% 110%, rgba(245,166,35,0.10), transparent 60%)"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.35]"
    style="background-image:linear-gradient(to right,#243f80 1px,transparent 1px),linear-gradient(to bottom,#243f80 1px,transparent 1px);background-size:72px 72px;mask-image:radial-gradient(ellipse 90% 70% at 50% 0%,#000 20%,transparent 75%);-webkit-mask-image:radial-gradient(ellipse 90% 70% at 50% 0%,#000 20%,transparent 75%)"
  >
  </div>

  <Container width="wide" class="relative">
    <div
      class="grid items-center gap-14 py-16 sm:py-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:py-28"
    >
      <div>
        <a
          href="/sodium-ion/"
          class="group inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/5 py-1.5 pr-4 pl-2 text-sm font-medium text-ink-200 backdrop-blur-sm transition-colors hover:border-volt-500/60 hover:text-white"
        >
          <span class="relative flex size-2 shrink-0">
            <span
              class="absolute inline-flex size-full animate-ping rounded-full bg-volt-500 opacity-75"
            ></span>
            <span class="relative inline-flex size-2 rounded-full bg-volt-500"
            ></span>
          </span>
          India's 1st prismatic sodium-ion prototype
          <Icon
            name="arrowRight"
            class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </a>

        <h1
          class="mt-7 text-[2.5rem] leading-[1.06] text-white sm:text-5xl lg:text-[3.5rem]"
        >
          {/* The explicit {' '} matters: Astro collapses the newline before an
              inline element, which would render "storage forrenewable". */}
          Battery energy storage for{' '}
          <span class="text-volt-400">renewable power plants</span>{' '}
          and the grid.
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-300">
          Your partner for energy storage needs and 100% green energy
          implementation — from concept to commissioning.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <Button href="/product/" size="lg" icon="right">
            Explore Pod Gen 1
          </Button>
          <Button href="/contact/" size="lg" variant="onDark">
            Talk to our team
          </Button>
        </div>

        <dl
          class="mt-11 flex flex-wrap gap-x-10 gap-y-4 border-t border-white/10 pt-7"
        >
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink-400 uppercase">
              Registered
            </dt>
            <dd class="mt-1 text-sm font-bold text-white">
              {company.incorporated}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink-400 uppercase">
              Based in
            </dt>
            <dd class="mt-1 text-sm font-bold text-white">
              {company.address.city}, {company.address.state}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink-400 uppercase">
              CIN
            </dt>
            <dd class="mt-1 font-mono text-sm font-bold text-white">
              {company.cin}
            </dd>
          </div>
        </dl>
      </div>

      <div class="relative">
        <div
          class="rounded-hero border border-white/10 bg-white/[0.04] p-5 backdrop-blur-sm sm:p-6"
        >
          <div class="rounded-panel bg-white p-6 shadow-brand-xl sm:p-7">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p
                  class="text-xs font-bold tracking-[0.14em] text-brand-600 uppercase"
                >
                  Flagship system
                </p>
                <p class="mt-1 text-xl font-extrabold text-brand-950">
                  Pod Gen 1
                </p>
              </div>
              <span
                class="rounded-full bg-volt-100 px-3 py-1 text-xs font-bold text-volt-700"
              >
                In production
              </span>
            </div>

            <PodVisual class="mt-3" />

            <ul class="mt-1 grid grid-cols-2 gap-2.5">
              {
                chips.map((chip) => (
                  <li class="flex items-center gap-2 rounded-lg bg-ink-100 px-3 py-2.5 text-[0.8125rem] font-semibold text-ink-700">
                    <Icon
                      name={chip.icon}
                      class="size-4 shrink-0 text-brand-600"
                    />
                    {chip.label}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
