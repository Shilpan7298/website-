---
/**
 * Horizontal gutter + max-width wrapper. The single source of page margin —
 * if the site's edge spacing ever changes, it changes here and nowhere else.
 *
 * The padding scale (20px → 24px → 32px) is what guarantees content never
 * touches the screen edge on a 375px phone.
 */
interface Props {
  class?: string;
  /** `narrow` for long-form prose, `wide` for grids and tables. */
  width?: 'narrow' | 'default' | 'wide';
}

const { class: className = '', width = 'default' } = Astro.props;

const widths = {
  narrow: 'max-w-3xl',
  default: 'max-w-6xl',
  wide: 'max-w-7xl',
} as const;
---

<div class={`mx-auto w-full px-5 sm:px-6 lg:px-8 ${widths[width]} ${className}`}>
  <slot />
</div>
