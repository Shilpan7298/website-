---
interface Props {
  class?: string;
  /** `narrow` for long-form prose, `wide` for grids and tables. */
  width?: 'narrow' | 'default' | 'wide';
}

const { class: className = '', width = 'default' } = Astro.props;

const widths = {
  narrow: 'max-w-3xl',
  default: 'max-w-6xl',
  wide: 'max-w-7xl',
} as const;
---

<div class={`mx-auto w-full px-5 sm:px-6 lg:px-8 ${widths[width]} ${className}`}>
  <slot />
</div>
