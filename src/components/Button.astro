---
/**
 * The only button/link-button in the system. Everything clickable that looks
 * like a button goes through here, so hover, focus and disabled behaviour stay
 * identical everywhere.
 *
 * Polymorphic: renders an <a> when `href` is passed, a <button> otherwise.
 * That matters for accessibility — a thing that navigates must be a link (it
 * belongs in the tab order as a link, supports open-in-new-tab, and is
 * announced as a link), and a thing that acts must be a button.
 */
import Icon from './Icon.astro';

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'ghost' | 'onDark';
  size?: 'sm' | 'md' | 'lg';
  /** Trailing arrow. `right` for navigation, `upRight` for outbound. */
  icon?: 'right' | 'upRight' | 'none';
  class?: string;
  /** Anything else (id, data-*, aria-*, download…) is forwarded to the tag. */
  [key: string]: unknown;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  icon = 'none',
  class: className = '',
  ...rest
} = Astro.props;

// `group` lets the trailing arrow animate on hover of the whole button.
// `cursor-pointer` is explicit because Tailwind's reset gives <button> the
// default cursor, which makes buttons feel inert.
const base =
  'group inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg font-semibold transition-all duration-200 ease-[var(--ease-out-soft)] disabled:cursor-not-allowed disabled:opacity-50';

// `onDark` is a translucent white treatment for navy sections — a solid
// secondary button would punch a bright hole in a dark band.
const variants = {
  primary:
    'bg-accent-600 text-white shadow-soft-sm hover:bg-accent-700 hover:shadow-soft-md active:bg-accent-800',
  secondary:
    'border border-ink-300 bg-white text-ink-900 shadow-soft-sm hover:border-ink-400 hover:bg-ink-50 hover:shadow-soft-md',
  ghost: 'text-accent-600 hover:bg-accent-50 hover:text-accent-700',
  onDark:
    'border border-white/25 bg-white/10 text-white backdrop-blur-sm hover:border-white/40 hover:bg-white/20',
} as const;

// md is h-11 = 44px, the minimum comfortable touch target. `sm` (40px) is used
// only in the desktop header, where input is a mouse and the 44px floor for
// touch does not apply.
const sizes = {
  sm: 'h-10 px-4 text-sm',
  md: 'h-11 px-5 text-[0.9375rem]',
  lg: 'h-13 px-7 text-base',
} as const;

const cls = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
const Tag = href ? 'a' : 'button';
const tagProps = href ? { href } : { type };
---

<Tag class={cls} {...tagProps} {...rest}>
  <slot />
  {
    icon === 'right' && (
      <Icon
        name="arrowRight"
        class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
      />
    )
  }
  {
    icon === 'upRight' && (
      <Icon
        name="arrowUpRight"
        class="size-4 shrink-0 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
      />
    )
  }
</Tag>
