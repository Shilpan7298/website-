---
import Container from './Container.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { company, nav } from '../data/site';

const year = new Date().getFullYear();
const { address } = company;
---

<footer class="border-t border-ink-800 bg-ink-950 text-ink-400">
  <Container width="wide">
    <div class="grid gap-12 py-16 lg:grid-cols-[1.4fr_1fr_1fr] lg:gap-16">
      <div>
        <Logo tone="onDark" />
        <p class="mt-5 max-w-sm text-[0.9375rem] leading-relaxed text-ink-400">
          Battery energy storage for renewable power plants and the grid —
          from concept and design through commissioning, operations and
          maintenance.
        </p>
        <a
          href={company.linkedin}
          rel="noopener noreferrer"
          target="_blank"
          class="mt-6 inline-flex size-11 cursor-pointer items-center justify-center rounded-lg border border-ink-800 text-ink-400 transition-colors hover:border-ink-700 hover:text-white"
          aria-label="Urjapod Energy on LinkedIn"
        >
          <Icon name="linkedin" class="size-5" />
        </a>
      </div>

      <nav aria-label="Footer">
        <h2 class="text-xs font-bold tracking-[0.14em] text-white uppercase">
          Company
        </h2>
        <ul class="mt-5 space-y-3">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-[0.9375rem] text-ink-400 transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-xs font-bold tracking-[0.14em] text-white uppercase">
          Get in touch
        </h2>
        <ul class="mt-5 space-y-4 text-[0.9375rem]">
          <li class="flex gap-3">
            <Icon name="mapPin" class="mt-0.5 size-4 shrink-0 text-ink-400" />
            <address class="not-italic text-ink-400">
              {address.line1}<br />
              {address.line2}<br />
              {address.city}, {address.state} {address.postcode}<br />
              {address.country}
            </address>
          </li>
          <li class="flex gap-3">
            <Icon name="mail" class="mt-0.5 size-4 shrink-0 text-ink-400" />
            <a
              href={`mailto:${company.email}`}
              class="text-ink-400 transition-colors hover:text-white"
            >
              {company.email}
            </a>
          </li>
          <li class="flex gap-3">
            <Icon name="phone" class="mt-0.5 size-4 shrink-0 text-ink-400" />
            <a
              href={`tel:${company.phoneHref}`}
              class="text-ink-400 transition-colors hover:text-white"
            >
              {company.phone}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="flex flex-col gap-3 border-t border-ink-800/80 py-7 text-sm text-ink-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {company.legalName}. All rights reserved.</p>
      <p>CIN: {company.cin}</p>
    </div>
  </Container>
</footer>
