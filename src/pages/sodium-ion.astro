---
/**
 * Sodium Ion page.
 *
 * A page in its own right, matching the live site's navigation, rather than a
 * footnote on the product page.
 *
 * IMPORTANT: keep the framing honest. Sodium-ion is prototype-stage R&D and
 * is NOT in a shipping Pod — Pod Gen 1 uses LFP today. Claiming a sodium-ion
 * product that does not exist yet would be a real problem in a tender.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTASection from '../components/CTASection.astro';
import Reveal from '../components/Reveal.astro';
import Icon from '../components/Icon.astro';
import { sodiumIon } from '../data/site';

/**
 * Indicative cell-level characteristics of each chemistry in general — widely
 * published figures, NOT Urjapod measurements. The footnote below says so.
 */
const comparison: { label: string; sodium: string; lfp: string }[] = [
  { label: 'Thermal stability', sodium: 'High', lfp: 'High' },
  { label: 'Safe at 0 V for transport', sodium: 'Yes', lfp: 'No' },
  { label: 'Cold-weather performance', sodium: 'Strong', lfp: 'Moderate' },
  { label: 'Cell energy density', sodium: '120–160 Wh/kg', lfp: '150–180 Wh/kg' },
  { label: 'Lithium required', sodium: 'No', lfp: 'Yes' },
  { label: 'Cobalt / nickel required', sodium: 'No', lfp: 'No' },
  { label: 'Raw-material price exposure', sodium: 'Very low', lfp: 'Low' },
];
---

<BaseLayout
  title="Sodium-Ion Batteries — India's First Prismatic Prototype"
  description="Urjapod Energy is building India's first prototype batteries with prismatic sodium-ion cells — a safer, longer-lived chemistry with a wider temperature range and lower cost than lithium."
  breadcrumbs={[{ label: 'Sodium Ion', href: '/sodium-ion/' }]}
>
  <PageHeader
    eyebrow="Sodium Ion"
    title={sodiumIon.headline}
    lead={sodiumIon.summary}
  />

  {/* Why the chemistry matters */}
  <Section width="wide">
    <SectionHeader
      eyebrow="Why sodium-ion"
      title="The chemistry energy storage has been waiting for."
      lead="Electric vehicles optimise for energy per kilogram, because weight is the constraint. A container standing on a foundation has no such constraint — so it should optimise for safety, life and cost instead."
      class="mb-12"
    />

    <ul class="grid gap-5 sm:grid-cols-2">
      {
        sodiumIon.benefits.map((b, i) => (
          <Reveal as="li" index={i} class="h-full">
            <div class="flex h-full gap-5 rounded-panel border border-ink-200 bg-white p-7 shadow-brand-sm">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                <Icon name={b.icon} class="size-5" />
              </span>
              <div>
                <h3 class="text-lg text-brand-950">{b.title}</h3>
                <p class="mt-2.5 leading-relaxed text-ink-600">{b.body}</p>
              </div>
            </div>
          </Reveal>
        ))
      }
    </ul>
  </Section>

  {/* Comparison */}
  <Section tone="muted" width="default">
    <SectionHeader
      eyebrow="Compared"
      title="Sodium-ion against the LFP we ship today."
      class="mb-10"
    />

    <Reveal>
      <p class="mb-3 flex items-center gap-1.5 text-sm text-ink-600 sm:hidden">
        <Icon name="arrowRight" class="size-4" />
        Scroll the table sideways to compare
      </p>

      <div
        class="overflow-x-auto overscroll-x-contain rounded-panel border border-ink-200 bg-white shadow-brand-sm"
        tabindex="0"
        role="region"
        aria-label="Sodium-ion and LFP chemistry comparison, scrollable"
      >
        <table class="w-full min-w-[34rem] text-left text-sm">
          <caption class="sr-only">
            Indicative comparison of sodium-ion and LFP cell characteristics.
          </caption>
          <thead>
            <tr class="border-b border-ink-200">
              <th
                scope="col"
                class="w-[44%] px-5 py-4 text-xs font-bold tracking-[0.12em] text-ink-600 uppercase"
              >
                Characteristic
              </th>
              <th scope="col" class="bg-brand-50 px-5 py-4 text-center">
                <span class="block text-base font-extrabold text-brand-950">
                  Sodium-ion
                </span>
                <span class="mt-1 block text-xs font-semibold text-brand-700">
                  In development
                </span>
              </th>
              <th scope="col" class="px-5 py-4 text-center">
                <span class="block text-base font-extrabold text-brand-950">
                  LFP
                </span>
                <span class="mt-1 block text-xs font-semibold text-ink-600">
                  Pod Gen 1 today
                </span>
              </th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map((row) => (
                <tr class="border-b border-ink-200/70 last:border-0">
                  <th
                    scope="row"
                    class="px-5 py-3.5 text-left font-semibold text-ink-800"
                  >
                    {row.label}
                  </th>
                  <td class="bg-brand-50/60 px-5 py-3.5 text-center font-semibold text-brand-950">
                    {row.sodium}
                  </td>
                  <td class="px-5 py-3.5 text-center font-medium text-ink-600">
                    {row.lfp}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mt-4 text-sm text-ink-600">
        Indicative cell-level characteristics for each chemistry in general —
        not Pod&nbsp;Gen&nbsp;1 system specifications. Actual performance
        depends on cell supplier, pack design and duty cycle.
      </p>
    </Reveal>
  </Section>

  {/* Honest status */}
  <Section tone="dark" width="default" size="sm">
    <Reveal class="mx-auto max-w-3xl text-center">
      <span
        class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-semibold text-white"
      >
        <Icon name="flask" class="size-4 text-volt-400" />
        Where this stands today
      </span>
      <p class="mt-6 text-xl leading-relaxed text-ink-300">
        Sodium-ion cells are <strong class="font-bold text-white">not yet in
        a shipping Pod</strong>. Pod Gen 1 uses prismatic LFP today. The
        sodium-ion work is prototype-stage research aimed at the next
        generation — and it is being done in India, so the supply chain behind
        it is too.
      </p>
    </Reveal>
  </Section>

  <CTASection
    title="Want to talk about the roadmap?"
    lead="If sodium-ion is relevant to a project you are planning, or you want to understand where the chemistry will be by the time you commission, we are glad to go into detail."
    secondaryLabel="See Pod Gen 1"
    secondaryHref="/product/"
  />
</BaseLayout>
