---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ChemistryTable from '../components/ChemistryTable.astro';
import CTASection from '../components/CTASection.astro';
import Reveal from '../components/Reveal.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';

/**
 * Technology page — chemistry, control and safety.
 *
 * The sodium-ion section is worded carefully: prototype-stage R&D, explicitly
 * NOT in a shipping Pod. Keep that distinction if you edit the copy; claiming
 * a sodium-ion product that does not exist yet would be a real problem in a
 * tender response.
 *
 * ChemistryTable's figures are general cell-level characteristics of each
 * chemistry, not Urjapod measurements — the component carries its own
 * footnote saying so.
 */
const bmsCapabilities = [
  {
    title: 'Cell-level visibility',
    body: 'Voltage, current and temperature are tracked per cell rather than per module, so a single weak cell is visible long before it drags the string down.',
  },
  {
    title: 'Predictive balancing',
    body: 'Balancing is scheduled against how cells are actually drifting, instead of reacting once they have already diverged.',
  },
  {
    title: 'Early fault detection',
    body: 'Deviation from a cell’s own learned baseline flags developing faults — internal resistance creep, thermal anomalies — as maintenance items, not outages.',
  },
  {
    title: 'State estimation',
    body: 'State of charge and state of health are estimated continuously, so dispatch decisions are made against real available capacity.',
  },
] as const;

const safetyLayers = [
  {
    icon: 'battery',
    title: 'Cell',
    body: 'LFP chemistry with a high thermal runaway threshold, cell-level fusing, and a stable structure that does not release oxygen under stress.',
  },
  {
    icon: 'cpu',
    title: 'Management',
    body: 'The BMS enforces voltage, current and temperature limits, and isolates a string before an out-of-band condition can propagate.',
  },
  {
    icon: 'thermometer',
    title: 'Thermal',
    body: 'Active cooling keeps the pack in its optimal band; modules are physically separated so heat does not cascade between them.',
  },
  {
    icon: 'shield',
    title: 'Enclosure',
    body: 'Gas and smoke detection, aerosol suppression, pressure relief, and an ingress-rated container that keeps dust and water out.',
  },
] as const;
---

<BaseLayout
  title="Technology — LFP, Sodium-Ion and AI-Enabled BMS"
  description="How Urjapod builds safe, long-life battery storage: prismatic LFP cells, an AI-enabled battery management system, layered fire safety, and India's first prismatic sodium-ion prototype cells."
>
  <PageHeader
    eyebrow="Technology"
    title="Chemistry, control and safety."
    lead="A grid battery is judged on three things: whether it is safe, how long it lasts, and whether it does what the dispatch signal asked. Every choice below serves one of those."
  />

  {/* Chemistry */}
  <Section width="wide">
    <SectionHeader
      eyebrow="Chemistry"
      title="Why LFP for stationary storage."
      lead="Electric vehicles optimise for energy per kilogram, because weight is the constraint. A container sitting on a foundation has no such constraint — so it should optimise for safety, cycle life and cost instead. That points to LFP."
      class="mb-10"
    />
    <Reveal>
      <ChemistryTable />
    </Reveal>
  </Section>

  {/* Sodium-ion */}
  <Section tone="dark" width="wide">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
      <Reveal>
        <span
          class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-white"
        >
          <Icon name="flask" class="size-4 text-accent-300" />
          In development
        </span>
        <h2 class="mt-6 text-3xl leading-tight text-white sm:text-4xl">
          Sodium-ion, made in India.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-400">
          We are building India's first prototype batteries with prismatic
          sodium-ion cells.
        </p>
      </Reveal>

      <Reveal index={1}>
        <p class="text-lg leading-relaxed text-ink-400">
          Sodium-ion is the upcoming chemistry best suited to energy storage.
          Sodium is abundant and cheap, and the chemistry needs no lithium, no
          cobalt and no nickel — which removes the raw-material volatility that
          makes lithium cell pricing hard to plan around.
        </p>

        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            [
              {
                title: 'Inherently safer',
                body: 'Can be transported and stored at zero volts, which lithium chemistries cannot.',
              },
              {
                title: 'Longer life',
                body: 'Tolerates deep daily cycling with less degradation per cycle.',
              },
              {
                title: 'Wider temperature range',
                body: 'Holds capacity in cold conditions where lithium cells fall away.',
              },
              {
                title: 'Lower cost trajectory',
                body: 'Built from abundant materials with no critical-mineral exposure.',
              },
            ].map((item) => (
              <li class="rounded-panel border border-ink-800 bg-ink-900 p-5">
                <h3 class="text-base text-white">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-400">
                  {item.body}
                </p>
              </li>
            ))
          }
        </ul>

        <p class="mt-8 text-[0.9375rem] leading-relaxed text-ink-400">
          Sodium-ion cells are not yet in a shipping Pod. Pod Gen 1 uses LFP
          today; the sodium-ion work is prototype-stage R&amp;D aimed at the
          next generation.
        </p>
      </Reveal>
    </div>
  </Section>

  {/* BMS */}
  <Section width="wide">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
      <Reveal>
        <p class="text-xs font-bold tracking-[0.14em] text-accent-600 uppercase">
          Control
        </p>
        <h2 class="mt-3 text-3xl leading-tight sm:text-4xl">
          The BMS is the product.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-600">
          Cells are a commodity; anyone can buy good ones. What separates a
          battery that lasts a decade from one that quietly loses a third of
          its capacity in three years is how well the management system
          understands what each cell is doing.
        </p>
        <div class="mt-8">
          <Button href="/products/" variant="secondary" icon="right">
            See it in Pod Gen 1
          </Button>
        </div>
      </Reveal>

      <ul class="grid gap-4 sm:grid-cols-2">
        {
          bmsCapabilities.map((item, i) => (
            <Reveal as="li" index={i} class="h-full">
              <div class="h-full rounded-panel border border-ink-200 bg-white p-6 shadow-soft-sm">
                <h3 class="text-base text-ink-950">{item.title}</h3>
                <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-600">
                  {item.body}
                </p>
              </div>
            </Reveal>
          ))
        }
      </ul>
    </div>
  </Section>

  {/* Safety */}
  <Section tone="muted" width="wide">
    <SectionHeader
      eyebrow="Safety"
      title="Four layers, so no single failure matters."
      lead="Battery safety is not one feature. It is a chain of independent defences, each of which assumes the one before it has already failed."
      class="mb-12"
    />
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        safetyLayers.map((layer, i) => (
          <Reveal as="li" index={i} class="h-full">
            <div class="flex h-full flex-col rounded-panel border border-ink-200 bg-white p-7 shadow-soft-sm">
              <div class="flex items-center gap-3">
                <span class="flex size-11 items-center justify-center rounded-lg bg-accent-50 text-accent-600">
                  <Icon name={layer.icon} class="size-5" />
                </span>
                <span class="font-mono text-sm font-bold text-ink-600">
                  0{i + 1}
                </span>
              </div>
              <h3 class="mt-5 text-lg text-ink-950">{layer.title}</h3>
              <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-600">
                {layer.body}
              </p>
            </div>
          </Reveal>
        ))
      }
    </ol>
  </Section>

  <CTASection
    title="Want the engineering detail?"
    lead="We are happy to go deeper on cell selection, BMS architecture, thermal design or safety certification with your technical team."
    primaryLabel="Talk to an engineer"
    secondaryLabel="See the product"
  />
</BaseLayout>
