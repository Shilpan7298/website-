---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Hero from '../components/Hero.astro';
import CapabilityBento from '../components/CapabilityBento.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CTASection from '../components/CTASection.astro';
import Reveal from '../components/Reveal.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import PodVisual from '../components/PodVisual.astro';
import {
  podGen1,
  showProvisionalMarkers,
  pillars,
  vision,
  sodiumIon,
} from '../data/site';

/**
 * Home page.
 *
 * Section order follows the "Enterprise Gateway" pattern from the design
 * system: hero → what we do → applications → the product → R&D → process →
 * CTA. The intent is that a visitor can stop reading at any point and still
 * have got something useful.
 *
 * Page-local content (applications, process) is defined here rather than in
 * src/data/site.ts because nothing else uses it. Only facts and figures that
 * appear in more than one place, or that need auditing, live in site.ts.
 */
const applications = [
  {
    icon: 'sun',
    title: 'Solar firming and shifting',
    body: 'Absorb the midday peak and release it into the evening ramp, so a solar plant sells power in the hours it is actually worth something.',
  },
  {
    icon: 'wind',
    title: 'Wind smoothing',
    body: 'Buffer the minute-to-minute variability of a wind farm and hold output inside the schedule the grid code requires.',
  },
  {
    icon: 'grid',
    title: 'Grid ancillary services',
    body: 'Frequency regulation, reserve capacity and voltage support — the fast-response services a battery provides better than any thermal plant.',
  },
  {
    icon: 'factory',
    title: 'C&I peak shaving',
    body: 'Cut demand charges and ride through outages at industrial and commercial sites, without running a diesel set.',
  },
] as const;

const process = [
  {
    step: '01',
    title: 'Design and feasibility',
    body: 'We start from your generation profile, tariff structure and grid connection terms, then size the system against the duty cycle you actually need to serve.',
  },
  {
    step: '02',
    title: 'Build and commission',
    body: 'Supply, civil works, installation, integration with your inverters and SCADA, and the testing needed to energise and hand over.',
  },
  {
    step: '03',
    title: 'Operate and maintain',
    body: 'Remote monitoring, scheduled servicing, capacity testing and warranty administration across the life of the asset.',
  },
] as const;

// Show the specs that are load-bearing on the home page; the full table
// lives on the product page.
const headlineSpecs = podGen1.specs.slice(0, 6);
---

<BaseLayout
  title="Urjapod Energy — Grid-Scale Battery Energy Storage"
  description="Urjapod Energy designs and builds containerised battery energy storage systems (BESS) for solar, wind and hybrid power plants in India — from concept and design through commissioning and O&M."
  bareTitle
>
  <Hero />

  {/* The company's three stated areas of work, carried over from the original
      site. This is Urjapod's own framing of the business — it sits directly
      under the hero because it is the first thing the original site says. */}
  <Section width="wide">
    <SectionHeader
      eyebrow="What we do"
      title="Energy storage is critical to the further adoption of renewable energy."
      lead="We provide high-tech, reliable and cost-effective battery energy storage solutions — across the whole life of a project."
      class="mb-12"
    />
    <ul class="grid gap-5 md:grid-cols-3">
      {
        pillars.map((pillar, i) => (
          <FeatureCard
            icon={pillar.icon}
            title={pillar.title}
            body={pillar.body}
            index={i}
          />
        ))
      }
    </ul>
  </Section>

  {/* Capability bento */}
  <Section tone="muted" width="wide">
    <SectionHeader
      eyebrow="How we work"
      title="Storage is what makes renewable power dispatchable."
      lead="A solar plant produces when the sun is up, not when demand peaks. Storage closes that gap — and closing it well takes a partner who owns the whole scope, not just the box."
      class="mb-12"
    />
    <CapabilityBento />
  </Section>

  {/* Applications */}
  <Section id="applications" width="wide">
    <SectionHeader
      eyebrow="Applications"
      title="Where a battery earns its keep."
      lead="The same hardware serves very different business cases. We size and configure it for the one you are actually building."
      class="mb-12"
    />
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        applications.map((app, i) => (
          <FeatureCard
            icon={app.icon}
            title={app.title}
            body={app.body}
            href="/solutions/"
            index={i}
          />
        ))
      }
    </ul>
  </Section>

  {/* Pod Gen 1 */}
  <Section tone="muted" width="wide">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <Reveal>
        <p class="text-xs font-bold tracking-[0.14em] text-accent-600 uppercase">
          The product
        </p>
        <h2 class="mt-3 text-3xl leading-tight sm:text-4xl lg:text-[2.75rem]">
          Pod Gen 1
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-600">
          {podGen1.summary} High energy density, inbuilt safety protection, and
          an enclosure rated against dust and water — built to global
          environmental standards and shipped as a single drop-in unit.
        </p>

        <dl class="mt-9 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-ink-200 pt-8">
          {
            headlineSpecs.map((spec) => (
              <div>
                <dt class="text-xs font-semibold tracking-wide text-ink-600 uppercase">
                  {spec.label}
                </dt>
                <dd class="mt-1 font-semibold text-ink-950">{spec.value}</dd>
              </div>
            ))
          }
        </dl>

        {
          showProvisionalMarkers &&
            headlineSpecs.some((s) => !s.verified) && (
              <p class="mt-5 text-sm text-ink-600">
                Some figures are provisional pending final test data — see the
                full specification.
              </p>
            )
        }

        <div class="mt-9">
          <Button href="/products/" size="lg" icon="right">
            Full specification
          </Button>
        </div>
      </Reveal>

      <Reveal
        index={1}
        class="rounded-hero border border-ink-200 bg-white p-8 shadow-soft-lg"
      >
        <PodVisual />
      </Reveal>
    </div>
  </Section>

  {/* Sodium-ion R&D */}
  <Section tone="dark" width="wide">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <Reveal>
        <span
          class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-white"
        >
          <Icon name="flask" class="size-4 text-accent-300" />
          Research and development
        </span>
        <h2 class="mt-6 text-3xl leading-tight text-white sm:text-4xl">
          India's first prototype batteries with prismatic sodium-ion cells.
        </h2>
      </Reveal>

      <Reveal index={1}>
        <p class="text-lg leading-relaxed text-ink-400">
          {sodiumIon.summary}
        </p>
        <p class="mt-5 text-lg leading-relaxed text-ink-400">
          It uses no lithium, no cobalt and no nickel, which takes the raw
          material volatility out of the cost curve — so the next generation of
          Pod need not depend on an imported supply chain.
        </p>
        <div class="mt-8">
          <Button href="/products/" size="lg" variant="onDark" icon="right">
            See the product range
          </Button>
        </div>
      </Reveal>
    </div>
  </Section>

  {/* The company's stated ambition, from the original site. Given a section
      of its own rather than buried, because it is the strongest thing the
      original copy says about where the business is going. */}
  <Section tone="muted" width="default" size="sm">
    <Reveal class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold tracking-[0.14em] text-accent-600 uppercase">
        Our ambition
      </p>
      <p class="mt-5 text-2xl leading-snug font-semibold text-ink-950 sm:text-[1.75rem]">
        {vision}
      </p>
    </Reveal>
  </Section>

  {/* Process */}
  <Section width="wide">
    <SectionHeader
      eyebrow="Delivery"
      title="From concept to commissioning, and everything after."
      class="mb-12"
    />
    <ol class="grid gap-5 md:grid-cols-3">
      {
        process.map((item, i) => (
          <Reveal as="li" index={i} class="h-full">
            <div class="flex h-full flex-col rounded-panel border border-ink-200 bg-white p-8 shadow-soft-sm">
              <span class="font-mono text-sm font-bold text-accent-600">
                {item.step}
              </span>
              <h3 class="mt-4 text-xl text-ink-950">{item.title}</h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-600">
                {item.body}
              </p>
            </div>
          </Reveal>
        ))
      }
    </ol>
  </Section>

  <CTASection />
</BaseLayout>
